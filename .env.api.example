FORGE_API_PORT=8787
FORGE_DB_PATH=./.data/forge.sqlite
FORGE_EXPORT_DIR=./.data/exports
FORGE_PUBLIC_BASE_URL=https://api.example.com
# Optional: USDA FoodData Central key; keep it on the API server only.
FORGE_USDA_API_KEY=
# Optional: real training catalog endpoint; it must return { exercises, nextCursor } and is never replaced with seeded data.
FORGE_TRAINING_CATALOG_URL=
FORGE_TRAINING_CATALOG_API_KEY=
FORGE_SESSION_SECRET=replace-with-at-least-32-random-characters
FORGE_CORS_ORIGIN=http://localhost:8081
# Optional: required before password reset can report delivery readiness.
FORGE_PASSWORD_RESET_WEBHOOK_URL=
# Optional: required before email verification can report delivery readiness.
FORGE_EMAIL_VERIFICATION_WEBHOOK_URL=
FORGE_EMAIL_VERIFICATION_WEBHOOK_SECRET=
# Optional: an OpenAI-compatible provider. These values stay on the API server.
FORGE_AI_BASE_URL=
FORGE_AI_API_KEY=
FORGE_AI_MODEL=
# Optional: OpenAI-compatible speech-to-text endpoint; audio is not stored by FORGE.
FORGE_VOICE_TRANSCRIPTION_URL=
FORGE_VOICE_API_KEY=
FORGE_VOICE_MODEL=
FORGE_OPS_METRICS_TOKEN=

# User-visible security audit retention, clamped server-side to 30-730 days.
FORGE_SECURITY_AUDIT_RETENTION_DAYS=180
FORGE_PRIVACY_POLICY_VERSION=2026-09-10
FORGE_PRIVACY_POLICY_EFFECTIVE_AT=2026-09-10
